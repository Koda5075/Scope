# Local dev only: `supabase functions serve --env-file supabase/functions/.env`
# In production, set these with `supabase secrets set NAME=value` — never commit real values.

RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=
RIOT_API_KEY=
RIOT_ACCOUNT_REGION=europe

# Must exactly match the redirect URI registered with Riot's RSO app.
RSO_REDIRECT_URI=https://<project-ref>.supabase.co/functions/v1/rso-callback

# Frontend origin rso-callback bounces the browser back to after login.
APP_URL=http://localhost:5173

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by the platform in
# production Edge Functions — only needed here for local `functions serve`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used by moderate-avatar to call Claude's vision API before a profile photo is ever
# accepted. Get one at https://console.anthropic.com — in production set with
# `supabase secrets set ANTHROPIC_API_KEY=...`, never commit the real value.
ANTHROPIC_API_KEY=
