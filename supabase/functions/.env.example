# Local dev only: `supabase functions serve --env-file supabase/functions/.env`
# In production, set these with `supabase secrets set NAME=value` — never commit real values.

# RIOT_CLIENT_ID / RIOT_CLIENT_SECRET come from a registered RSO application (needed
# for "Log in with Riot" — not registered yet, leave blank).
RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=

# RIOT_API_KEY can be a personal daily development key (RGAPI-…, from
# https://developer.riotgames.com, regenerates every 24h) or the production key once
# approved. A daily key is enough for val-status / val-leaderboard / account-v1.
RIOT_API_KEY=

# Continent shard for account-v1 (europe | americas | asia).
RIOT_ACCOUNT_REGION=europe

# Must exactly match the redirect URI registered with Riot's RSO app.
RSO_REDIRECT_URI=https://<project-ref>.supabase.co/functions/v1/rso-callback

# Frontend origin rso-callback bounces the browser back to after login.
APP_URL=http://localhost:5173

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by the platform in
# production Edge Functions — only needed here for local `functions serve`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used by moderate-avatar to call Claude's vision API before a profile photo is ever
# accepted. Get one at https://console.anthropic.com — in production set with
# `supabase secrets set ANTHROPIC_API_KEY=...`, never commit the real value.
ANTHROPIC_API_KEY=

# Used by create-checkout-session to create Stripe Checkout sessions server-side
# (test mode secret key, starts with sk_test_). Get one at
# https://dashboard.stripe.com/test/apikeys — in production set with
# `supabase secrets set STRIPE_SECRET_KEY=...`, never commit the real value.
STRIPE_SECRET_KEY=
